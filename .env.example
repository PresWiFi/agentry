# Optional. Everything else (SSO, public URL, proxies, users) is set on the Settings and Users pages.

# Encrypts stored secrets and signs sessions. Empty = generated once and kept in the data volume.
# Set it if you want the key outside the volume. Changing it makes stored secrets unreadable.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTRY_SECRET_KEY=

# Skip the first-run setup page: creates local user "admin" with this password on first start only.
AGENTRY_ADMIN_PASSWORD=

# Pre-fill Settings on first start only (later changes here are ignored; use the Settings page):
# AGENTRY_PUBLIC_URL, AGENTRY_TRUSTED_PROXIES, AGENTRY_LOCAL_LOGIN, OIDC_ISSUER, OIDC_CLIENT_ID,
# OIDC_CLIENT_SECRET, OIDC_LABEL, OIDC_SCOPES, OIDC_GROUPS_CLAIM, OIDC_ADMIN_GROUPS,
# OIDC_REVIEWER_GROUPS, OIDC_VIEWER_GROUPS, OIDC_DEFAULT_ROLE, OIDC_ALLOWED_DOMAINS
