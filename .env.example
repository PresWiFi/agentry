# Copy to .env and fill in. Restart the container after changes.

# Encrypts stored API keys and signs sessions. Empty = generated once and kept in the data volume.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes stored secrets unreadable (re-enter them) and signs everyone out.
AGENTRY_SECRET_KEY=

# Address people use to reach Agentry. Used for the SSO redirect URI: <this>/auth/oidc/callback
AGENTRY_PUBLIC_URL=https://agentry.example.com
# Set true when served over HTTPS (reverse proxy), so the session cookie is HTTPS-only.
AGENTRY_SECURE_COOKIES=true
# Reverse proxy IPs whose X-Forwarded-* headers are trusted.
AGENTRY_TRUSTED_PROXIES=127.0.0.1

# Local "admin" account for setup and break-glass. Leave empty to have no local account.
AGENTRY_ADMIN_PASSWORD=
# Set false once SSO works to turn password sign-in off.
AGENTRY_LOCAL_LOGIN=true

# OpenID Connect. Issuer examples:
#   Entra ID:  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Authentik: https://auth.example.com/application/o/agentry/
#   Keycloak:  https://keycloak.example.com/realms/<realm>
#   Google:    https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Sign in with SSO
OIDC_SCOPES=openid email profile
# Role mapping from the groups claim (Entra sends group object IDs). First match wins: admin, reviewer, viewer.
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUPS=
OIDC_REVIEWER_GROUPS=
OIDC_VIEWER_GROUPS=
# Role for users matching no group: none (denied), viewer, reviewer, admin
OIDC_DEFAULT_ROLE=none
# Optional: only allow these email domains, comma-separated.
OIDC_ALLOWED_DOMAINS=
